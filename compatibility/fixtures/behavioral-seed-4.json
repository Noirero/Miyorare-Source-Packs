          "expected": [{"url": "/manga/d1", "title": "Doujin One"}, {"url": "/manga/d2", "title": "Doujin Two"}]
        },
        "search": {
          "response": {"format": "html", "body": "<div class='entry'><a class='metadata' href='/manga/d1' title='Doujin One'>Doujin One</a></div>"},
          "extractor": {"kind": "regex-list", "pattern": "<div class='entry'><a class='metadata' href='(?P<url>[^']+)' title='(?P<title>[^']+)'>"},
          "expected": [{"url": "/manga/d1", "title": "Doujin One"}]
        },
        "details": {
