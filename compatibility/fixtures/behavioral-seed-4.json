          "extractor": {"kind": "regex-list", "pattern": "<a class='chapter' href='(?P<url>[^']+)'>(?P<title>[^<]+)</a>"},
          "expected": [{"url": "/reader/d1/2", "title": "Chapter 2"}, {"url": "/reader/d1/1", "title": "Chapter 1"}]
        },
        "content": {
          "response": {"format": "html", "body": "<img class='page' src='https://img.example/d1-1.jpg'><img class='page' src='https://img.example/d1-2.jpg'>"},
          "extractor": {"kind": "regex-list", "pattern": "<img class='page' src='(?P<url>[^']+)'"},
