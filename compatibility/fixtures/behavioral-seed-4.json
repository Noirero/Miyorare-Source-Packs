          "extractor": {"kind": "regex-object", "fields": {"title": "<h1>([^<]+)</h1>", "description": "<div class='summary'>([^<]+)</div>", "cover": "<img class='thumb' src='([^']+)'"}},
          "expected": {"title": "Doujin One", "description": "Adult fixture synopsis", "cover": "https://img.example/d1.jpg"}
