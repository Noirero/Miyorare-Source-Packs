{
  "schemaVersion": 1,
  "families": {
    "manga-reader-plus-api": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["MangaReaderParser("],
        ["selectPage"],
        ["selectChapter"],
        ["apiDomain", "getPages"]
      ]
    },
    "custom-rest-json": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["PagedMangaParser("],
        ["getRequestHeaders", "getApiHeaders"],
        ["parseJson", "JSONObject", "mapJSON"],
        ["getPages"]
      ]
    },
    "custom-auth-cookie-html": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["MangaParserAuthProvider"],
        ["isAuthorized"],
        ["getCookies"],
        ["access_token"],
        ["getPages"]
      ]
    },
    "natsu": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["NatsuParser("]
      ]
    },
    "madara": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["MadaraParser("],
        ["selectChapter", "getDetails", "getPages"]
      ]
    },
    "custom-paged-form-api": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["PagedMangaParser("],
        ["FormBody", "RequestBody"],
        ["refererInterceptor", "Referer"],
        ["requestBrowserAction", "dleGuardInterceptor"],
        ["getPages"]
      ]
    },
    "custom-paged-html-json": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["PagedMangaParser("],
        ["parseHtml", "JSONObject", "toJSONObjectOrNull"],
        ["getListPage"],
        ["getDetails"],
        ["getPages"]
      ]
    },
    "custom-paged-html-xhr": {
      "requiredTokenGroups": [
        ["@MangaSourceParser("],
        ["PagedMangaParser("],
        ["X_REQUESTED_WITH", "XMLHttpRequest"],
        ["REFERER", "Referer"],
        ["getListPage"],
        ["getDetails"],
        ["getPages"]
      ]
    }
  }
}
